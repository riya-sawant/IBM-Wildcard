# NovaHealth backend - environment variables template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Option A: full connection string (recommended for cloud/production)
#   Format:  postgresql://USER:PASSWORD@HOST:PORT/DBNAME
#   Note: URL-encode special characters in the password (e.g. @ -> %40)
DATABASE_URL=postgresql://user:password@localhost:5432/novahealth

# Option B: individual variables (easier for local dev)
# If DATABASE_URL is not set (or is the placeholder above), these are used.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=novahealth
# DB_USER=postgres
# DB_PASSWORD=

# ── JWT secrets ───────────────────────────────────────────────────────────────
# Generate with: node -e "require('crypto').randomBytes(64).toString('hex')"
# Use DIFFERENT secrets for access and refresh tokens.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── IBM watsonx.ai ────────────────────────────────────────────────────────────
WATSONX_API_KEY=
WATSONX_SPACE_ID=
WATSONX_URL=
WATSONX_MODEL_ID=

# ── Google Gemini (photo analysis) ───────────────────────────────────────────
GEMINI_API_KEY=

# ── Groq (voice summary) ─────────────────────────────────────────────────────
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
# The exact origin of the frontend (no trailing slash)
# Dev:        http://localhost:5173
# Production: https://your-domain.com
FRONTEND_ORIGIN=http://localhost:5173

PORT=5001

# Set to "production" when deploying
NODE_ENV=development
